# Environment Variables Template
# Copy this file to .env.local and fill in your values

# ==================== CLOUDINARY ====================
# Get from: https://cloudinary.com/console/settings/account
# This is your Cloudinary cloud name for CDN image delivery
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# ==================== RESEND (Email) ====================
# Get from: https://resend.com/api-keys
# API key for sending emails via Resend
RESEND_API_KEY=re_your_api_key_here

# Email address where contact form submissions will be sent
RESEND_CONTACT_EMAIL=your-email@example.com

# ==================== OPTIONAL ====================
# MongoDB connection string (if using database)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# Frontend contact email (alternative)
VITE_CONTACT_EMAIL=contact@sbg-hitms.dev

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:3000
VITE_APP_URL=http://localhost:8080

# ==================== DEBUG (Optional) ====================
# Uncomment to enable verbose logging
# DEBUG=*
